OPENAI_API_KEY=
# Optional: route through an OpenAI-compatible gateway.
OPENAI_BASE_URL=
MODEL=gpt-5.4
# none | minimal | low | medium | high. Reasoning models only; remove the line for gpt-4.x.
REASONING_EFFORT=low

DATABASE_URL=postgresql://chatbot:chatbot@localhost:5433/chatbot

# Knowledge base embeddings, served by the same OpenAI endpoint as the chat model.
EMBEDDING_MODEL=text-embedding-3-small
# Local cross-encoder that reorders search results (~570 MB download, cached in
# ~/.cache/fastembed). Leave empty to turn reranking off.
RERANKER_MODEL=BAAI/bge-reranker-v2-m3-int8

# Long threads: once messages pass CONTEXT_MAX_TOKENS (estimated), older turns are
# summarized by SUMMARY_MODEL, keeping about the most recent half verbatim.
SUMMARY_MODEL=gpt-5-nano
CONTEXT_MAX_TOKENS=10000
# `make retention` keeps only the latest checkpoint of threads idle this many days.
CHECKPOINT_RETENTION_DAYS=30

# Long-term memory: small per-user memories, updated by MEMORY_MODEL from thread summaries
# when a thread passes CONTEXT_MAX_TOKENS, and recalled when a new thread starts.
MEMORY_ENABLED=true
MEMORY_MODEL=gpt-5-mini
MEMORY_RECALL_LIMIT=10

# Redact emails, card numbers, IPs and phone numbers from user messages, tool results and
# replies. Set to false to turn it off. Emails at the allowed domains (a JSON list) are kept.
PII_ENABLED=true
# PII_ALLOWED_EMAIL_DOMAINS=["acme-outfitters.example"]

# Human approval before risky tool calls. Web searches mentioning any HITL_SENSITIVE_TERMS
# (a JSON list), or containing an order number, wait for approval.
HITL_ENABLED=true
# HITL_SENSITIVE_TERMS=["confidential", "internal", "codename", "Project Falcon"]

# Web search uses DuckDuckGo (no API key). Set to false to turn the web_search tool off.
WEB_SEARCH_ENABLED=true

# Tracing is enabled when both keys are set. These match the project that the
# local Langfuse (docker-compose.langfuse.yml) creates on first start.
LANGFUSE_PUBLIC_KEY=pk-lf-local-dev
LANGFUSE_SECRET_KEY=sk-lf-local-dev
LANGFUSE_HOST=http://localhost:3000

LOG_LEVEL=INFO
