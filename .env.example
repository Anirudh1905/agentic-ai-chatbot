OPENAI_API_KEY=
# Optional: route through an OpenAI-compatible gateway.
OPENAI_BASE_URL=
MODEL=gpt-5.4
# none | minimal | low | medium | high. Sent to reasoning models (gpt-5.x, o-series) only.
REASONING_EFFORT=low
# Seconds per model call (a reply, a summary, a memory push).
REQUEST_TIMEOUT=30
# Cap on the output tokens of every chat-model call (replies, summaries, memory pushes); unset by
# default (the model's own limit). On gpt-5.x it counts reasoning tokens too.
# MAX_TOKENS=4000
# When MODEL fails (timeouts, connection errors, 429s, 5xx), after MODEL_MAX_RETRIES retries, the
# call goes to this model on the same endpoint (Phase 10). Empty: no fallback.
FALLBACK_MODEL=gpt-4.1
# Also the embeddings client's retries; embeddings have no fallback.
MODEL_MAX_RETRIES=1
# Circuit breakers per model, the embeddings and web search (Phase 10), shared in Redis: this
# many failures within the window open one for the cooldown.
# BREAKER_FAILURES=5
# BREAKER_WINDOW_SECONDS=60
# BREAKER_COOLDOWN_SECONDS=30
# One run at a time per thread (Phase 10): the lease lasts this long, renewed every third of it.
# THREAD_LEASE_SECONDS=60
# Cap on model calls per request, so a confused model can't loop forever.
# MAX_MODEL_CALLS=6
# Scores answers in the evals; changing it means re-running make eval-calibrate.
# JUDGE_MODEL=gpt-4.1

# Where the services are: required, no defaults in config.py. These are the kind cluster's, through
# Tilt (Postgres on a NodePort via socat, Redis and ElasticMQ port-forwards; the dev login is local only; see deploy/local/kustomization.yaml).
DATABASE_URL=postgresql://dev:dev@localhost:5433/chatbot

# Knowledge base embeddings, served by the same OpenAI endpoint as the chat model.
EMBEDDING_MODEL=text-embedding-3-small
# Must match the vector column in migrations/versions/0001_chunks.py.
# EMBEDDING_DIMENSIONS=1536
# CHUNK_SIZE_TOKENS=600
# CHUNK_OVERLAP_TOKENS=80
# Candidates from each of vector and full-text search, the chunks kept, and a cap on one
# search's results in estimated tokens (Phase 11).
# RETRIEVAL_CANDIDATES=30
# RETRIEVAL_TOP_K=6
# RETRIEVAL_MAX_TOKENS=2500
# Local cross-encoder that reorders search results (~570 MB download, cached in
# ~/.cache/fastembed). Leave empty to turn reranking off.
RERANKER_MODEL=BAAI/bge-reranker-v2-m3-int8
# How many fused results the reranker scores, and where its model is cached (default
# ~/.cache/fastembed; the cluster uses /models).
# RERANK_CANDIDATES=8
# RERANKER_CACHE_DIR=/models

# Long threads: once messages pass CONTEXT_MAX_TOKENS (estimated), older turns are
# summarized by SUMMARY_MODEL, keeping about the most recent half verbatim.
SUMMARY_MODEL=gpt-4.1-mini
CONTEXT_MAX_TOKENS=10000
# Before that (Phase 11), past this many tokens the model is sent only the latest
# CONTEXT_KEEP_TOOL_RESULTS search results; the thread keeps them all. 0 turns it off.
CONTEXT_CLEAR_TOOL_RESULTS_TOKENS=6000
CONTEXT_KEEP_TOOL_RESULTS=3
# `make retention` keeps only the latest checkpoint of threads idle this many days.
CHECKPOINT_RETENTION_DAYS=30

# Long-term memory: a thread's turns are pushed into per-user memories at its token breach,
# when it's idle for MEMORY_THREAD_TTL_MINUTES, or when the user asks ("Remember this", or
# "remember that..."); every turn recalls the memories closest to the user's message.
MEMORY_ENABLED=true
MEMORY_THREAD_TTL_MINUTES=30
MEMORY_TTL_CHECK_EVERY_MINUTES=1
MEMORY_MODEL=gpt-5-mini
MEMORY_RECALL_LIMIT=10
# Pushes at once per API process; each holds a pooled connection while it runs.
MEMORY_WRITE_CONCURRENCY=2
# Whether this process runs the idle-thread scan and the store's TTL sweeper. The API pods
# set it to false in the cluster, where the worker runs them (Phase 9).
# BACKGROUND_JOBS=true

# Redact emails, card numbers, IPs and phone numbers from user messages, tool results and
# replies. Set to false to turn it off. Emails at the allowed domains (a JSON list) are kept.
PII_ENABLED=true
# PII_ALLOWED_EMAIL_DOMAINS=["acme-outfitters.example"]

# Human approval before risky tool calls. Web searches mentioning any HITL_SENSITIVE_TERMS
# (a JSON list), or containing an order number, wait for approval.
HITL_ENABLED=true
# HITL_SENSITIVE_TERMS=["confidential", "internal", "codename", "Project Falcon", "salary", "payroll", "password"]

# Web search uses DuckDuckGo (no API key). Set to false to turn the web_search tool off.
WEB_SEARCH_ENABLED=true
# WEB_SEARCH_MAX_RESULTS=5
# WEB_SEARCH_TIMEOUT=15
# Seconds a query's results are kept in Redis (REDIS_URL), shared by every API pod. 0: no cache.
WEB_SEARCH_CACHE_SECONDS=600

# Authentication: accounts log in at POST /auth/login and get a token; every request needs
# `Authorization: Bearer <JWT>`, and the user is its `sub`. JWT_SECRET signs and verifies the
# tokens: at least 32 characters; generate one, e.g. `openssl rand -hex 32`.
JWT_SECRET=
JWT_TTL_MINUTES=60

# Limits, counted in Redis (in the cluster) and shared by every API process: requests per
# user and per IP, and model tokens per user per UTC day (0 turns the budget off). If Redis
# is down, requests go through.
RATE_LIMITS_ENABLED=true
REDIS_URL=redis://localhost:6380/0
RATE_LIMIT_PER_USER=120/minute
RATE_LIMIT_PER_IP=300/minute
# Register and log-in attempts per IP (against password guessing).
RATE_LIMIT_LOGIN=10/minute
DAILY_TOKEN_BUDGET=500000

# The queue memory pushes go through (Phase 9): ElasticMQ in the cluster, standing in
# for Amazon SQS. Leave SQS_QUEUE_URL unset to run pushes in-process, without a worker. With it
# set, run the worker too: python -m chatbot.worker (or make worker).
# SQS_QUEUE_URL=http://localhost:9324/000000000000/memory-pushes.fifo
# SQS_DEAD_LETTER_QUEUE_URL=http://localhost:9324/000000000000/memory-pushes-dlq.fifo
# SQS_ENDPOINT_URL=http://localhost:9324
# SQS_ACCESS_KEY_ID=local
# SQS_SECRET_ACCESS_KEY=local
# SQS_REGION=us-east-1
# Where the worker serves its metrics, and, if set, a separate port for the API's (then
# /metrics answers 404). METRICS_PORT is unset by default; the cluster sets it.
# WORKER_METRICS_PORT=9100
# METRICS_PORT=9100

# Tracing is enabled when both keys and the host are set. These match the project that the
# local Langfuse (ops/langfuse/docker-compose.yml) creates on first start.
LANGFUSE_PUBLIC_KEY=pk-lf-local-dev
LANGFUSE_SECRET_KEY=sk-lf-local-dev
LANGFUSE_HOST=http://localhost:3000

LOG_LEVEL=INFO

# The Streamlit UI's address for the API (ui/app.py reads it, not config.py).
# CHATBOT_API_URL=http://localhost:8000
# How long an API pod's preStop drain waits for open streams (api/drain.py reads it, not config.py).
# DRAIN_TIMEOUT_SECONDS=55
