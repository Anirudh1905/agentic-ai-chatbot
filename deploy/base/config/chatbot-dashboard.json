      },
      "gridPos": {
        "x": 12,
        "y": 41,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(chatbot_approval_pauses_total[1h])) / sum(rate(chatbot_http_requests_total{route=~\"/chat.*\"}[1h]))",
          "legendFormat": "runs paused for approval"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
